{
  "name": "the-lodash",
  "version": "3.0.0",
  "description": "Extension to Lodash library",
  "main": "dist/index.js",
  "types": "dist",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "test": "env TS_NODE_COMPILER_OPTIONS='{\"module\": \"commonjs\" }' mocha -r ts-node/register 'test/**/*.ts'",
    "build": "tsc",
    "format": "prettier --write ./src/ ./test/",
    "format-check": "prettier --check ./src/ ./test/",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'"
  },
  "author": "Ruben Hakopian <ruben.hakopian@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rubenhak/nodejs-the-lodash.git"
  },
  "bugs": {
    "url": "https://github.com/rubenhak/nodejs-the-lodash/issues"
  },
  "homepage": "https://github.com/rubenhak/nodejs-the-lodash#readme",
  "dependencies": {
    "fast-deep-equal": "3.1.3",
    "fast-json-stable-stringify": "2.1.0",
    "lodash": "4.18.1",
    "@types/lodash": "4.17.24"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.0",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "mocha": "^11.7.6",
    "prettier": "^3.9.4",
    "should": "^13.2.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {}
  }
}
